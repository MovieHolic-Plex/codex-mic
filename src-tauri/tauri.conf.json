{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Mic",
  "version": "0.1.0",
  "identifier": "com.codexmic.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Mic",
        "width": 300,
        "height": 34,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": true,
        "y": 40,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Codex voice dictation",
    "longDescription": "Ctrl+E to dictate text into any window using Codex's realtime API."
  }
}
